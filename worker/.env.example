# HTTP
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Optional durable state/media database. Without this, the worker falls back
# to local disk, which is suitable for development but not restart-safe hosting.
# DATABASE_URL=postgresql://...

# Temporary working directories
WORK_DIR=./.work
STATE_DIR=./.clipforge-state

# Automatic cleanup
MEDIA_RETENTION_DAYS=7
MAX_UPLOAD_BYTES=629145600

# Optional binary overrides. Defaults work automatically.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# YT_DLP_PATH=./.tools/yt-dlp
# YT_DLP_DOWNLOAD_URL=https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp
# WHISPER_CPP_DIR=./.tools/whispercpp
# WHISPER_CPP_BINARY_URL=https://github.com/ggml-org/whisper.cpp/releases/download/v1.9.2/whisper-bin-ubuntu-x64.tar.gz
# WHISPER_CPP_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny-q5_1.bin
# WHISPER_THREADS=4

# ClipForge V3 intentionally has no OpenAI/Groq/OpenRouter/Lovable API keys.
