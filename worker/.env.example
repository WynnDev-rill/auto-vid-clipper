# HTTP
PORT=8787
# Shared bearer secret the ClipForge app sends as `Authorization: Bearer <secret>`.
# Must match CLIPFORGE_BACKEND_SECRET in the Lovable app.
BACKEND_SECRET=change-me

# OpenAI Whisper (speech-to-text)
OPENAI_API_KEY=sk-...

# Lovable AI Gateway (LLM highlight scoring)
LOVABLE_API_KEY=lk_...
LOVABLE_MODEL=google/gemini-3-flash-preview

# Where rendered clips are served from. If empty, the worker serves them
# from /media/<jobId>/<file>.mp4 on PUBLIC_BASE_URL.
PUBLIC_BASE_URL=http://localhost:8787

# Optional: path to ffmpeg/ffprobe if not in $PATH
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Working dir for downloads + renders
WORK_DIR=./.work
