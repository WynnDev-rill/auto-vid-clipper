# HTTP
PORT=8787
# Shared bearer secret the ClipForge app sends as `Authorization: Bearer <secret>`.
# Must match CLIPFORGE_BACKEND_SECRET in the Lovable app.
BACKEND_SECRET=change-me

# ============ Whisper (speech-to-text) providers ============
# Configure any/all — the worker picks based on the "Whisper Provider" setting
# in the app (default: Auto → Groq → OpenAI → OpenRouter, with automatic
# fallback on rate limit / timeout / insufficient balance / server error).

# Groq (recommended: fast + free tier for Whisper)
GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3

# OpenAI (official)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_WHISPER_MODEL=whisper-1

# OpenRouter
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_WHISPER_MODEL=openai/whisper-1
# OPENROUTER_REFERER=https://clipforge.ai
# OPENROUTER_TITLE=ClipForge AI Worker

# Optional: initial provider before anyone changes it in Settings.
# One of: auto | groq | openai | openrouter
# WHISPER_PROVIDER=auto

# Lovable AI Gateway (LLM highlight scoring)
LOVABLE_API_KEY=lk_...
LOVABLE_MODEL=google/gemini-3-flash-preview

# Where rendered clips are served from. If empty, the worker serves them
# from /media/<jobId>/<file>.mp4 on PUBLIC_BASE_URL.
PUBLIC_BASE_URL=http://localhost:8787

# Optional: path to ffmpeg/ffprobe if not in $PATH
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Working dir for downloads + renders
WORK_DIR=./.work
STATE_DIR=./.clipforge-state
